{
  "manifest_version": 3,
  "name": "No Posts No Shorts For YouTube",
  "description": "Remove Posts and Shorts from YouTube",
  "version": "1.0.2",
  "homepage_url": "https://github.com/codexico/no_posts_no_shorts",
  "developer": {
    "name": "Francisco Kahil",
    "url": "https://codexico.com.br"
  },
  "icons": {
    "32": "icons/icon_32.png",
    "64": "icons/icon_64.png",
    "128": "icons/icon_128.png",
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "css": ["hide.css"],
      "js": ["content_script.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "@no_posts_no_shorts",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "id": "@no_posts_no_shorts",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
